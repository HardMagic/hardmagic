{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hardmagic.com/schemas/brief-lock/dataverse-bridge-contract.schema.json",
  "title": "HardMagic BriefLock CRM event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventType", "requestId", "ledgerPath", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventType": {
      "enum": [
        "hardmagic.brief.requested",
        "hardmagic.consultation.requested",
        "hardmagic.engagement.suppressed"
      ]
    },
    "requestId": { "type": "string", "format": "uuid" },
    "ledgerPath": { "type": "string", "pattern": "^requests/[0-9]{4}-[0-9]{2}/[0-9a-f-]+\\.json$" },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
