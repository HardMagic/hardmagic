---
const base = import.meta.env.BASE_URL;
---
<section class="sonic-ident" aria-labelledby="sonic-title">
  <div>
    <p class="eyebrow">Sonic mark · original HardMagic composition</p>
    <h2 id="sonic-title">Hear the signal.</h2>
    <p>A 20-second abstract tonal ident—low frequencies, harmonic pulse, no speech. Playback never starts without you.</p>
  </div>
  <audio controls preload="metadata">
    <source src={`${base}media/audio/hardmagic-signal.ogg`} type="audio/ogg; codecs=opus" />
    Your browser does not support the audio element. <a href={`${base}media/audio/hardmagic-signal.ogg`}>Download the sonic ident</a>.
  </audio>
</section>
