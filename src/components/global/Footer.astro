---
import Wordmark from './Wordmark.astro';
import { productLinks } from '../../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div><Wordmark /><p>Dream in reality.</p><p class="quiet">An independent marketing, media, and creative-technology studio.</p></div>
    <div><h2>Products</h2>{productLinks.map(([label, href]) => <a href={href}>{label}</a>)}</div>
    <div><h2>Company</h2><a href="company/">About HardMagic</a><a href="contact/">Start a conversation</a><a href="privacy/">Privacy</a></div>
  </div>
  <div class="shell legal">© {year} HardMagic Corporation. Delaware, USA.</div>
</footer>
