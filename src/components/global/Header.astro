---
import Wordmark from './Wordmark.astro';
import { navigation } from '../../data/site';
const path = Astro.url.pathname;
---
<header class:list={['site-header', { 'on-light': path !== '/' }]}>
  <div class="shell header-inner">
    <Wordmark />
    <nav aria-label="Primary navigation">
      {navigation.map((item) => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>
