---
import Wordmark from './Wordmark.astro';
import { navigation } from '../../data/site';
const path = Astro.url.pathname;
const isHome = path === import.meta.env.BASE_URL;
---
<header class:list={['site-header', { 'on-light': !isHome }]}>
  <div class="shell header-inner">
    <Wordmark />
    <nav aria-label="Primary navigation">
      {navigation.map((item) => <a href={item.href} aria-current={path.includes(`/${item.href}`) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>
