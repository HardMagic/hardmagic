---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/product/ProductCard.astro';
import Marquee from '../components/sections/Marquee.astro';
import CaseCard from '../components/portfolio/CaseCard.astro';
import WireMarkProof from '../components/home/WireMarkProof.astro';
import StudioSignal from '../components/home/StudioSignal.astro';
import { caseStudies } from '../data/portfolio';
import generativeOperations from '../assets/editorial/generative-operations-4k.avif';
import dreamSpecimen from '../assets/editorial/dream-media-specimen-4k.avif';
import '../styles/home-current.css';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const featured = products.filter((product) => product.data.featured);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="HardMagic — Agentic AI & Generative Media" description="HardMagic Corporation builds agentic AI, generative media, visual product intelligence, and verifiable delivery systems under human creative direction.">
  <section class="current-hero">
    <Picture src={generativeOperations} alt="A creative operator directs photographic material across an illuminated working table in a dark studio." formats={['avif', 'webp']} fallbackFormat="webp" width={1920} widths={[720, 1200, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="current-hero-shade"></div>
    <div class="shell current-hero-copy">
      <p class="eyebrow">HardMagic Corporation · Agentic AI + media</p>
      <h1>Direct the machine.<br /><em>Keep the magic.</em></h1>
      <p>We build the operating system between creative intent and machine execution—across image, sound, software, agents, and the public web.</p>
      <div class="hero-actions"><a class="button" href="#system">Explore the product system</a><a class="button ghost" href="#proof">See it working</a></div>
    </div>
    <div class="current-proof-rail" aria-label="Current HardMagic system">
      <span><b>01</b> Studio generates</span><span><b>02</b> WireMark directs</span><span><b>03</b> CLI orchestrates</span><span><b>04</b> Web Magic verifies</span>
    </div>
    <p class="hero-disclosure">HardMagic-directed generative concept image · not client or product evidence</p>
  </section>

  <Marquee />

  <section class="current-thesis shell section-pad">
    <div><p class="eyebrow dark">Independent by design</p><h2>Agentic media,<br />under human direction.</h2></div>
    <div><p>HardMagic operates where creative authority, generative media, software agents, and accountable delivery meet. Our products let people direct machine-scale work without surrendering judgment, provenance, or control.</p><p>More than twenty-five years of media practice sharpen the system. The work happening now defines where it goes.</p></div>
  </section>

  <section id="system" class="current-products section-pad">
    <header class="shell proof-heading">
      <div><p class="eyebrow">The HardMagic system</p><h2>Four instruments.<br /><em>One directed loop.</em></h2></div>
      <p>From first intention to inspectable evidence, every part of the constellation exists to keep human taste legible while agents do real work.</p>
    </header>
    <div class="shell current-system-map" aria-label="HardMagic product workflow">
      <a href="products/studio/"><span>01 / GENERATE</span><b>HardMagic Studio</b><p>Direct image, motion, voice, music, and form across owned and cloud inference.</p><i>IMAGE · VIDEO · AUDIO · 3D</i></a>
      <a href="products/wiremark/"><span>02 / OBSERVE</span><b>WireMark</b><p>Join the running product to source, visual intent, agent work, and verification evidence.</p><i>CANVAS · SOURCE · EVIDENCE</i></a>
      <a href="products/cli/"><span>03 / DELEGATE</span><b>HardMagic CLI</b><p>Give agents bounded context, permissions, repeatable commands, and acceptance gates.</p><i>AGENTS · AUTOMATION · CONTROL</i></a>
      <a href="products/web-magic/"><span>04 / VERIFY</span><b>Web Magic</b><p>Inspect accessibility, performance, search, security, and public delivery before release.</p><i>QUALITY · TRUST · DELIVERY</i></a>
    </div>
    <div class="shell product-grid current-product-grid">{featured.map((product, index) => <ProductCard id={product.id} data={product.data} index={index} />)}</div>
    <div class="shell section-end"><a class="button light" href="products/">Explore every HardMagic product</a></div>
  </section>

  <div id="proof" class="proof-zone section-pad">
    <WireMarkProof base={base} />
  </div>

  <StudioSignal base={base} />

  <section class="agent-loop section-pad">
    <div class="shell agent-loop-grid">
      <div class="agent-loop-copy"><p class="eyebrow">The agentic operating model</p><h2>Intent becomes<br /><em>an executable contract.</em></h2><p>An agent should know what it may touch, what evidence matters, how success is judged, and how to return the system safely. HardMagic makes those boundaries part of the creative surface.</p><a class="button ghost" href="methods/human-agent-creative-loop/">Open the method</a></div>
      <div class="agent-loop-diagram" aria-label="Directed agent workflow">
        <span class="loop-center">H</span>
        <ol>
          <li><b>Intent</b><small>the human direction</small></li>
          <li><b>Context</b><small>sources + constraints</small></li>
          <li><b>Action</b><small>bounded execution</small></li>
          <li><b>Evidence</b><small>what actually changed</small></li>
          <li><b>Decision</b><small>approve · revise · revert</small></li>
        </ol>
      </div>
    </div>
  </section>

  <figure class="future-field">
    <Picture src={dreamSpecimen} alt="A luminous waveform passes through film, paper, and a small projection apparatus on a black field." formats={['avif', 'webp']} fallbackFormat="webp" width={1920} widths={[720, 1200, 1920]} sizes="100vw" />
    <span class="future-field-shade" aria-hidden="true"></span>
    <div class="future-field-copy shell"><p class="eyebrow">Dispatch from 2035</p><h2>The next medium<br /><em>will remember why.</em></h2><p>Media becomes adaptive, spatial, conversational, and persistent. The winning systems will carry authorship, consent, rights, decisions, and memory alongside every output.</p><a class="text-link" href="horizon/">Enter Horizon 2035 <b>↗</b></a></div>
    <figcaption>HardMagic-directed conceptual media specimen · scenario artwork, not a forecast</figcaption>
  </figure>

  <section class="creative-continuity section-pad">
    <header class="shell proof-heading dark-heading"><div><p class="eyebrow dark">Creative direction in practice</p><h2>The eye behind<br /><em>the system.</em></h2></div><p>Selected case studies across image, identity, software, learning, hospitality, and place. This body of practice supports the present—it does not replace it.</p></header>
    <div class="portfolio-grid shell">{[caseStudies[1]!, caseStudies[5]!, caseStudies[0]!].map((study, index) => <CaseCard study={study} index={index} />)}</div>
    <div class="shell section-end"><a class="button dark-button" href="portfolio/">Explore the creative-direction portfolio</a></div>
  </section>

  <section class="current-close">
    <div class="shell"><p class="eyebrow">Privately owned · Delaware corporation · established 1999</p><h2>Studio generates.<br />WireMark directs.<br />CLI orchestrates.<br /><em>Web Magic verifies.</em></h2><p>Built for organizations that need creative force and technical accountability in the same room.</p><div><a class="button" href="contact/genai/">Build an agentic media system</a><a class="text-link" href="company/">Meet HardMagic <b>↗</b></a></div></div>
  </section>
</BaseLayout>
