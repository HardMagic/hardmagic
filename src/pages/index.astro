---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/product/ProductCard.astro';
import Marquee from '../components/sections/Marquee.astro';
import CaseCard from '../components/portfolio/CaseCard.astro';
import WireMarkProof from '../components/home/WireMarkProof.astro';
import StudioSignal from '../components/home/StudioSignal.astro';
import { caseStudies } from '../data/portfolio';
import generativeOperations from '../assets/editorial/generative-operations-4k.avif';
import dreamSpecimen from '../assets/editorial/dream-media-specimen-4k.avif';
import '../styles/home-current.css';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const featured = products.filter((product) => product.data.featured);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="HardMagic — Independent Marketing Studio" description="HardMagic is an award-winning independent marketing studio joining creative direction, media, GenAI, and proprietary technology to make brands impossible to ignore.">
  <section class="current-hero">
    <Picture src={generativeOperations} alt="A creative operator directs photographic material across an illuminated working table in a dark studio." formats={[]} fallbackFormat="avif" width={1920} widths={[720, 1200, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="current-hero-shade"></div>
    <div class="shell current-hero-copy">
      <p class="eyebrow">Independent marketing studio · GenAI native · since 1999</p>
      <h1>Make the future<br /><em>want you.</em></h1>
      <p>HardMagic creates brand worlds, campaigns, media, and digital experiences with human taste and machine-scale imagination.</p>
      <div class="hero-actions"><a class="button" href="contact/">Bring us the impossible brief</a><a class="button ghost" href="#work">See the work</a></div>
    </div>
    <div class="current-proof-rail" aria-label="Current HardMagic system">
      <span><b>01</b> Brand worlds</span><span><b>02</b> Campaigns</span><span><b>03</b> Intelligent media</span><span><b>04</b> Experiences</span>
    </div>
    <p class="hero-disclosure">HardMagic-directed generative concept image · not client or product evidence</p>
  </section>

  <Marquee />

  <section class="current-thesis shell section-pad">
    <div><p class="eyebrow dark">A marketing studio with its own machines</p><h2>Ideas first.<br />Everything else <em>obeys.</em></h2></div>
    <div><p>We direct brands, launches, campaigns, films, interfaces, editorial systems, and the intelligent media around them. Strategy and creative direction stay human. Generative production gives the idea more range.</p><p>Our proprietary products are not the headline. They are the unfair advantage behind the work.</p></div>
  </section>

  <StudioSignal base={base} />

  <section class="capability-stage" aria-labelledby="capability-title">
    <header class="capability-intro"><p class="eyebrow">What HardMagic does</p><h2 id="capability-title">Strategy to spectacle.<br /><em>One studio.</em></h2><p>We move from the boardroom question to the public experience without dropping the idea between departments.</p></header>
    <div class="capability-index">
      <a href="services/creative-direction/"><span>01</span><strong>Creative direction</strong><i>Meaning · taste · coherence</i></a>
      <a href="services/brand-systems/"><span>02</span><strong>Brand worlds</strong><i>Identity · voice · memory</i></a>
      <a href="services/campaign-production/"><span>03</span><strong>Campaigns</strong><i>Concept · production · launch</i></a>
      <a href="services/genai-strategy/"><span>04</span><strong>GenAI transformation</strong><i>Models · workflows · governance</i></a>
      <a href="services/media-management/"><span>05</span><strong>Media systems</strong><i>Archive · rights · distribution</i></a>
      <a href="services/web-experience/"><span>06</span><strong>Digital experiences</strong><i>Editorial · product · performance</i></a>
    </div>
  </section>

  <section id="work" class="creative-continuity section-pad">
    <header class="proof-heading dark-heading"><div><p class="eyebrow dark">Creative direction in practice</p><h2>Work that leaves<br /><em>a mark.</em></h2></div><p>Selected creative practice across image, identity, software, learning, hospitality, and place. The archive is context; the studio is moving forward.</p></header>
    <div class="portfolio-grid">{[caseStudies[1]!, caseStudies[5]!, caseStudies[6]!, caseStudies[7]!].map((study, index) => <CaseCard study={study} index={index} />)}</div>
    <div class="section-end"><a class="button dark-button" href="portfolio/">Explore the full portfolio</a></div>
  </section>

  <section class="agent-loop section-pad">
    <div class="agent-loop-grid">
      <div class="agent-loop-copy"><p class="eyebrow">Our production advantage</p><h2>Intent becomes<br /><em>an executable contract.</em></h2><p>Agents can move fast because the studio defines what they may touch, what evidence matters, and what still requires human judgment. The result is more creative range without creative drift.</p><a class="button ghost" href="methods/human-agent-creative-loop/">Open the method</a></div>
      <div class="agent-loop-diagram" aria-label="Directed agent workflow">
        <span class="loop-center">H</span>
        <ol><li><b>Idea</b><small>the human direction</small></li><li><b>World</b><small>context + constraints</small></li><li><b>Make</b><small>machine-scale production</small></li><li><b>Proof</b><small>what actually changed</small></li><li><b>Release</b><small>approve · revise · amplify</small></li></ol>
      </div>
    </div>
  </section>

  <section id="system" class="current-products section-pad">
    <header class="proof-heading">
      <div><p class="eyebrow">Proprietary studio instruments</p><h2>We built what<br /><em>the work demanded.</em></h2></div>
      <p>Studio, WireMark, CLI, and Web Magic extend our creative practice from first intention to inspectable delivery. Clients can engage the studio, the products, or both.</p>
    </header>
    <div class="current-system-map" aria-label="HardMagic product workflow">
      <a href="products/studio/"><span>01 / GENERATE</span><b>HardMagic Studio</b><p>Direct image, motion, voice, music, and form across owned and cloud inference.</p><i>IMAGE · VIDEO · AUDIO · 3D</i></a>
      <a href="products/wiremark/"><span>02 / OBSERVE</span><b>WireMark</b><p>Join the running product to source, visual intent, agent work, and verification evidence.</p><i>CANVAS · SOURCE · EVIDENCE</i></a>
      <a href="products/cli/"><span>03 / DELEGATE</span><b>HardMagic CLI</b><p>Give agents bounded context, permissions, repeatable commands, and acceptance gates.</p><i>AGENTS · AUTOMATION · CONTROL</i></a>
      <a href="products/web-magic/"><span>04 / VERIFY</span><b>Web Magic</b><p>Inspect accessibility, performance, search, security, and public delivery before release.</p><i>QUALITY · TRUST · DELIVERY</i></a>
    </div>
    <div class="product-grid current-product-grid">{featured.map((product, index) => <ProductCard id={product.id} data={product.data} index={index} />)}</div>
    <div class="section-end"><a class="button light" href="products/">Explore the studio instruments</a></div>
  </section>

  <div id="proof" class="proof-zone section-pad">
    <WireMarkProof base={base} />
  </div>

  <figure class="future-field">
    <Picture src={dreamSpecimen} alt="A luminous waveform passes through film, paper, and a small projection apparatus on a black field." formats={[]} fallbackFormat="avif" width={1920} widths={[720, 1200, 1920]} sizes="100vw" />
    <span class="future-field-shade" aria-hidden="true"></span>
    <div class="future-field-copy shell"><p class="eyebrow">Dispatch from 2035</p><h2>The next medium<br /><em>will remember why.</em></h2><p>Media becomes adaptive, spatial, conversational, and persistent. The winning systems will carry authorship, consent, rights, decisions, and memory alongside every output.</p><a class="text-link" href="horizon/">Enter Horizon 2035 <b>↗</b></a></div>
    <figcaption>HardMagic-directed conceptual media specimen · scenario artwork, not a forecast</figcaption>
  </figure>

  <section class="current-close">
    <div><p class="eyebrow">Privately owned · award-winning creative practice · established 1999</p><h2>Make something<br />the world cannot<br /><em>look away from.</em></h2><p>Strategy, creative direction, production, GenAI, media, and proprietary technology—inside one bold independent studio.</p><div><a class="button" href="contact/">Start a project</a><a class="text-link" href="company/">Meet HardMagic <b>↗</b></a></div></div>
  </section>
</BaseLayout>
