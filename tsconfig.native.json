{
  "compilerOptions": {
    "allowJs": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2025",
    "types": []
  },
  "include": ["astro.config.ts", "src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["dist", "site"]
}
